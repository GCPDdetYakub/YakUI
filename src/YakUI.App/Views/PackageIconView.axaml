<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YakUI.App.ViewModels"
             x:Class="YakUI.App.Views.PackageIconView"
             x:DataType="vm:PackageIconViewModel">
  <!-- FR-34a: заглушка — буква на цветном фоне и малый значок типа; поверх — загруженная иконка (FR-34). -->
  <Panel>
    <Border CornerRadius="6" Background="{Binding Background}" IsVisible="{Binding !HasImage}">
      <Viewbox Margin="6">
        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" />
      </Viewbox>
    </Border>
    <Image x:Name="IconImage" Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding HasImage}"
           RenderOptions.BitmapInterpolationMode="HighQuality" />
    <Border CornerRadius="3,0,6,0" Background="#B3000000" Padding="3,0,3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            IsVisible="{Binding HasKindBadge}">
      <TextBlock Text="{Binding KindBadge}" Foreground="White" FontSize="9" FontWeight="SemiBold" />
    </Border>
  </Panel>
</UserControl>
