<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YakUI.App.App"
             RequestedThemeVariant="Default">
  <!-- Default — следовать системной теме (FR-83). -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://YakUI/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
