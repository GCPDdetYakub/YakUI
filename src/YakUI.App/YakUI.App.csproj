<Project Sdk="Microsoft.NET.Sdk">

  <!-- GUI YakUI (AD-01): Avalonia 11 (MVVM, CommunityToolkit.Mvvm). Логика — в YakUI.Core (AD-05). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>YakUI.App</RootNamespace>
    <AssemblyName>YakUI</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YakUI.Core\YakUI.Core.csproj" />
    <ProjectReference Include="..\YakUI.Platform.Windows\YakUI.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Строки интерфейса (FR-82): Strings.resx — русский (нейтральный), Strings.en.resx — английский; DE — 1.1. Класс Strings генерируется MSBuild. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>YakUI.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YakUI.App.Tests" />
  </ItemGroup>

</Project>
